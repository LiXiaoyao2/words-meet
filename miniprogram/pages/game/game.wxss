.header{margin:4rpx 0 24rpx}.room{border:1rpx solid #f0d8df;border-radius:36rpx;padding:12rpx 18rpx;color:#c3778d;font-weight:800;font-size:34rpx;letter-spacing:4rpx}.players{margin-bottom:20rpx;align-items:stretch}.player{background:#fff;border-radius:22rpx;padding:18rpx;overflow:hidden}.face{height:64rpx;width:64rpx;display:flex;align-items:center;justify-content:center;background:#ffe6ed;border-radius:50%;color:#d8839c}.face image{width:100%;height:100%;border-radius:50%}.player-name{font-size:24rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin:8rpx 0}.round{font-size:21rpx;color:#cf93a3;letter-spacing:2rpx}.card .heading{margin:10rpx 0}.words{display:flex;flex-wrap:wrap;gap:12rpx;margin:20rpx 0}.word{background:#ffe9ef;border-radius:16rpx;padding:18rpx;color:#b86680;font-weight:700}.dice{width:80rpx;height:80rpx;background:#fff0f4;border-radius:16rpx;font-size:38rpx}.submit{margin-top:18rpx}.history{display:flex;justify-content:space-between;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid #f7e9eb;font-size:24rpx;word-break:break-all}.win{text-align:center;font-size:68rpx}.winning-word{font-size:40rpx;font-weight:800;color:#d57894;margin:22rpx}.float{position:fixed;left:0;top:40%;background:rgba(220,113,148,.6);color:#fff;border-radius:0 20rpx 20rpx 0;padding:14rpx;font-size:24rpx}.dan-panel{position:fixed;bottom:35rpx;left:25rpx;right:25rpx;padding:24rpx;background:#fff;border-radius:24rpx;box-shadow:0 10rpx 45rpx #69404b44}.dan-panel .row{margin-bottom:14rpx}.toast{position:fixed;top:18%;right:0;max-width:85%;padding:14rpx 25rpx;border-radius:40rpx;background:#d97c9de8;color:white;z-index:5;font-size:26rpx;word-break:break-all}
