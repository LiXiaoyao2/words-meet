.hero{text-align:center;padding:18rpx 0 28rpx}.choice{flex:1;min-width:0;padding:16rpx 4rpx;background:#fff7f8;border:1rpx solid #f0dce3;border-radius:16rpx;color:#ae7c8b;font-size:23rpx}.choice.selected,.chip.selected{background:#ffe9ef;border-color:#e48ca4;color:#bd627d}.capacity{margin-top:16rpx;flex-wrap:wrap}.chip{padding:10rpx 18rpx;border:1rpx solid #eedce0;border-radius:24rpx;font-size:23rpx;color:#a67886}.rules{margin-top:20rpx}.rules .muted{margin-top:12rpx}.mask{position:fixed;inset:0;z-index:10;background:rgba(57,35,48,.55);display:flex;align-items:center;justify-content:center;padding:40rpx}.match-card{width:100%;max-width:540rpx;background:#fff9fa;border-radius:32rpx;padding:40rpx;text-align:center}.match-card .button{margin-top:30rpx}.spinner{font-size:72rpx;color:#dc829b;animation:spin 1.4s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.avatar-line{margin-bottom:12rpx}.avatar{height:72rpx;width:72rpx;border-radius:50%;overflow:hidden;background:#ffedf1;display:flex;align-items:center;justify-content:center;flex:none}.avatar image{width:100%;height:100%}.avatar-line .label{margin:0}.remove-avatar{font-size:21rpx;color:#bd7c91}.avatar-canvas{position:fixed;left:-500px;top:-500px;width:160px;height:160px;pointer-events:none}
