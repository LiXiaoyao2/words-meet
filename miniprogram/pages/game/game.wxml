<view class="page {{state.mode === 'challenge' ? 'challenge' : ''}}">
  <view class="row header"><view class="grow"><view class="title">{{state.mode === 'challenge' ? '默契挑战 ✦' : '一起心动 ♡'}}</view><view class="muted">{{state.ranked ? '随机匹配 · 计分' : '自建/好友房 · 不计分'}} · {{state.players.length}}/{{state.capacity}} 人</view></view><view class="room">{{state.code}}</view></view>
  <view class="row players"><view wx:for="{{state.players}}" wx:key="friendCode" class="player grow" data-code="{{item.friendCode}}" bindtap="showProfile"><view class="face"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"/><text wx:else>✦</text></view><view class="player-name">{{item.name}}</view><view class="muted">{{item.ready ? '已提交 ✓' : '思考中'}}</view></view></view>
  <view class="card">
    <block wx:if="{{state.failed}}"><view class="heading">挑战结束 🏳️</view><view class="muted">{{state.failureReason === 'round_limit' ? '已达到轮次上限，本局挑战失败。' : '队友退出，场上只剩一人。'}}</view></block>
    <block wx:elif="{{state.won}}"><view class="win">🏆<view class="heading">{{state.mode === 'challenge' ? '挑战成功！' : '默契挑战！'}}</view><view class="muted">经过 {{state.history.length}} 轮，大家想到了</view><view class="winning-word">{{winningWord}}</view><button class="button" bindtap="reset">再玩一局</button></view></block>
    <block wx:else><view class="round">ROUND {{round}} / {{state.roundLimit}}</view><view class="heading">{{state.history.length ? '根据这些词继续联想' : '写下你的第一个词'}}</view><view class="muted">{{state.history.length ? '想一个能连接这些词的词，看看大家会不会想到一起。' : '不用商量，写下你想到的词语。'}}</view><view wx:if="{{lastWords.length}}" class="words"><text wx:for="{{lastWords}}" wx:key="index" class="word">{{item}}</text></view><view class="row"><input class="input grow" value="{{word}}" maxlength="20" placeholder="写下你的词语" disabled="{{state.submitted || state.players.length < state.capacity}}" bindinput="onWord"/><button wx:if="{{!state.history.length}}" class="dice" disabled="{{state.submitted || state.players.length < state.capacity}}" bindtap="roll">🎲</button></view><button class="button submit" disabled="{{state.submitted || state.players.length < state.capacity}}" bindtap="submit">{{state.players.length < state.capacity ? '等待玩家加入' : state.submitted ? '等待其他人提交…' : '提交词语'}}</button><view class="notice">{{error}}</view></block>
  </view>
  <view wx:if="{{state.history.length}}" class="card"><view class="heading">相遇轨迹</view><view wx:for="{{state.history}}" wx:for-item="roundWords" wx:for-index="roundIndex" wx:key="index" class="history"><text>{{roundIndex + 1}}</text><text wx:for="{{roundWords}}" wx:for-item="historyWord" wx:key="index">{{historyWord}}</text></view></view>
  <button class="button secondary" bindtap="leave">{{state.mode === 'challenge' ? '退出挑战' : '返回首页'}}</button>
  <button class="float" bindtap="toggleDanmaku">💬</button><view wx:if="{{danmakuOpen}}" class="dan-panel"><view class="row"><view class="heading grow">弹幕</view><button bindtap="toggleDanmaku">×</button></view><view class="row"><input class="input grow" value="{{danmaku}}" maxlength="60" placeholder="说点什么…" bindinput="onDanmaku"/><button class="button small" bindtap="sendDanmaku">发送</button></view></view>
  <view wx:if="{{overlay}}" class="toast">{{overlay}}</view>
</view>
