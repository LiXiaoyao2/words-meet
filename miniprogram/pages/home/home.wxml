<view class="page {{mode === 'challenge' ? 'challenge' : ''}}">
  <view class="hero"><text class="title">{{mode === 'challenge' ? '默契大挑战 ✦' : '心动相遇 ♡'}}</text><view class="muted">写下一个词，看看我们能否想到一起</view></view>
  <view class="card">
    <view class="row avatar-line"><button class="avatar" bindtap="chooseAvatar"><image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"/><text wx:else>📷</text></button><view class="grow"><view class="label">选择头像</view><text class="muted">轻触从相册选择，自动居中裁剪</text></view><button wx:if="{{avatar}}" class="remove-avatar" bindtap="clearAvatar">移除</button><button class="remove-avatar" bindtap="myProfile">我的战绩</button></view><canvas type="2d" id="avatarCanvas" class="avatar-canvas"/>
    <view class="label">昵称</view><input class="input" value="{{name}}" maxlength="12" placeholder="给自己起个昵称" bindinput="onName" />
    <view class="label">性别</view><view class="row"><button wx:for="{{genders}}" wx:key="value" class="choice {{gender === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="setGender">{{item.icon}} {{item.label}}</button></view>
    <view class="label">游戏模式</view><view class="row"><button class="choice {{mode === 'couple' ? 'selected' : ''}}" data-value="couple" bindtap="setMode">🌟 心动相遇</button><button class="choice {{mode === 'challenge' ? 'selected' : ''}}" data-value="challenge" bindtap="setMode">✨ 默契大挑战</button></view>
    <view wx:if="{{mode === 'challenge'}}" class="row capacity"><text class="muted">挑战人数</text><button class="chip {{capacity === 2 ? 'selected' : ''}}" data-value="2" bindtap="setCapacity">2 人</button><button class="chip {{capacity === 3 ? 'selected' : ''}}" data-value="3" bindtap="setCapacity">3 人</button><text class="muted">不限性别</text></view>
    <view class="spacer"/><button class="button" loading="{{matching}}" disabled="{{matching}}" bindtap="startMatch">随机匹配</button>
    <view class="spacer"/><button class="button secondary" disabled="{{matching}}" bindtap="createRoom">创建房间</button>
    <view class="spacer"/><view class="row"><input class="input grow" type="number" maxlength="4" placeholder="输入 4 位房间号" value="{{roomCode}}" bindinput="onCode"/><button class="button small secondary" disabled="{{matching}}" bindtap="joinRoom">加入房间</button></view>
  </view>
  <view class="row"><button class="button secondary grow" bindtap="openFriends">好友与邀请{{inviteCount ? " · " + inviteCount : ""}}</button><button class="button secondary grow" bindtap="openRanking">全服排行榜</button></view>
  <view class="card rules"><view class="heading">玩法说明</view><view class="muted">各自提交词语后同时揭晓，再从所有词联想。所有人写出相同的词即获胜。已揭晓的词不能重复；双人最多 12 轮，三人最多 20 轮。只有随机匹配计入积分。</view></view>
  <view wx:if="{{matching}}" class="mask"><view class="match-card"><view class="spinner">✦</view><view class="heading">正在寻找伙伴</view><view class="muted">至少等待 3 秒，可随时取消</view><button class="button secondary" bindtap="cancelMatch">取消匹配</button></view></view>
</view>
