page{background:#fff8f7;color:#573c48;font-size:28rpx;font-family:system-ui,sans-serif}view,text,button,input{box-sizing:border-box}button{margin:0;padding:0;border:0;line-height:1.2;background:none}button::after{border:0}.page{padding:28rpx 28rpx 80rpx}.card{background:#fff;border:1rpx solid #f3e2e5;border-radius:28rpx;padding:28rpx;margin-bottom:20rpx}.title{font-size:38rpx;font-weight:800}.muted{font-size:23rpx;color:#b696a0;line-height:1.6}.label{font-size:24rpx;color:#a97986;font-weight:700;margin:18rpx 0 10rpx}.input{height:80rpx;padding:0 22rpx;background:#fff7f8;border:1rpx solid #f0dce3;border-radius:18rpx}.button{display:flex;align-items:center;justify-content:center;min-height:80rpx;border-radius:18rpx;font-weight:700;background:#df7f99;color:#fff;font-size:28rpx}.button.secondary{background:#fbe9ed;color:#b66c81}.button.small{min-height:60rpx;padding:0 22rpx;font-size:23rpx}.button[disabled]{opacity:.5}.row{display:flex;align-items:center;gap:14rpx}.grow{flex:1;min-width:0}.heading{font-weight:800;font-size:30rpx}.spacer{height:18rpx}.notice{font-size:23rpx;color:#bb657b;margin-top:12rpx}.challenge{background:#f4fafb;color:#284e5b}.challenge .button{background:#278b8d}.challenge .button.secondary{background:#e2f3f0;color:#39827c}.challenge .input{background:#f5fafb;border-color:#d5e8e9}
